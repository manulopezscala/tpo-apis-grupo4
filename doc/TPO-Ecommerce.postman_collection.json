{
  "info": {
    "name": "TPO Ecommerce - Grupo 4",
    "description": "Colección completa de endpoints para el TPO de APIs Interactivas - UADE 2026.\n\n**Flujo recomendado:**\n1. Crear usuario ADMIN\n2. Login → el token se guarda automáticamente\n3. Crear categoría, producto, cart, etc.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4002",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Token guardado:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica usuario y retorna JWT. El token se guarda automáticamente en la variable `token` de la colección."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Obtener roles disponibles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/roles",
              "host": ["{{baseUrl}}"],
              "path": ["users", "roles"]
            },
            "description": "Devuelve los roles disponibles (USER, ADMIN) para usar al crear un usuario."
          }
        },
        {
          "name": "Obtener todos los usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"role\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Crea un nuevo usuario. El campo `role.id` debe apuntar a un Role existente (1=ADMIN, 2=USER según las filas en DB)."
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"nuevoPassword123\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"Actualizado\",\n  \"role\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Obtener todas las categorías",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Obtener categoría por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electrónica\",\n  \"description\": \"Productos electrónicos y tecnología\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Eliminar categoría",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Obtener todos los productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Obtener producto por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook Lenovo\",\n  \"description\": \"Notebook 15 pulgadas, 16GB RAM, 512GB SSD\",\n  \"price\": 1500.00,\n  \"stock\": 10,\n  \"active\": true,\n  \"seller\": {\n    \"id\": 1\n  },\n  \"category\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Notebook Lenovo Pro\",\n  \"description\": \"Notebook 15 pulgadas, 32GB RAM, 1TB SSD\",\n  \"price\": 2000.00,\n  \"stock\": 5,\n  \"active\": true,\n  \"seller\": {\n    \"id\": 1\n  },\n  \"category\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Eliminar producto",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Product Images",
      "item": [
        {
          "name": "Agregar imagen a producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/images/notebook.jpg\",\n  \"product\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/product-images",
              "host": ["{{baseUrl}}"],
              "path": ["product-images"]
            }
          }
        }
      ]
    },
    {
      "name": "Discounts",
      "item": [
        {
          "name": "Crear descuento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"percentage\": 15.0,\n  \"active\": true,\n  \"product\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/discounts",
              "host": ["{{baseUrl}}"],
              "path": ["discounts"]
            },
            "description": "Crea un descuento asociado a un producto. Solo puede haber un descuento por producto."
          }
        }
      ]
    },
    {
      "name": "Carts",
      "item": [
        {
          "name": "Obtener todos los carritos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/carts",
              "host": ["{{baseUrl}}"],
              "path": ["carts"]
            }
          }
        },
        {
          "name": "Obtener carrito por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/carts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["carts", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Crear carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"ARS\",\n  \"user\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/carts",
              "host": ["{{baseUrl}}"],
              "path": ["carts"]
            }
          }
        },
        {
          "name": "Checkout de carrito",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/carts/:id/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["carts", ":id", "checkout"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Cierra el carrito para generar una orden. El carrito debe tener al menos un item."
          }
        },
        {
          "name": "Eliminar carrito",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/carts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["carts", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Cart Items",
      "item": [
        {
          "name": "Agregar item al carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2,\n  \"unitPrice\": 1500.00,\n  \"cart\": {\n    \"id\": 1\n  },\n  \"product\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/cart-items",
              "host": ["{{baseUrl}}"],
              "path": ["cart-items"]
            }
          }
        },
        {
          "name": "Eliminar item del carrito",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/cart-items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["cart-items", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Obtener todas las órdenes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Obtener orden por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/:id",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Crear orden desde carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-04-13T00:00:00.000+00:00\",\n  \"total\": 3000.00,\n  \"status\": \"PENDING\",\n  \"user\": {\n    \"id\": 1\n  },\n  \"cart\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Crea una orden a partir de un carrito previamente cerrado con checkout."
          }
        },
        {
          "name": "Actualizar estado de orden",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", ":id", "status"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Solo ADMIN puede cambiar el estado. Enviar en el body: { \"status\": \"CONFIRMED\" }. Valores posibles: CREATED, PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED."
          }
        }
      ]
    },
    {
      "name": "Order Items",
      "item": [
        {
          "name": "Crear item de orden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2,\n  \"unitPrice\": 1500.00,\n  \"order\": {\n    \"id\": 1\n  },\n  \"product\": {\n    \"id\": 1\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/order-items",
              "host": ["{{baseUrl}}"],
              "path": ["order-items"]
            }
          }
        }
      ]
    }
  ]
}

